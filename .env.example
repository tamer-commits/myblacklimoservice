# MY BLACK LIMO SERVICE — production integration checklist
# Add REAL values only in Vercel > Project > Settings > Environment Variables.
# Never commit secret keys/tokens to GitHub.

# Google Maps Routes API — server only. Powers live route/fare calculation
# on /quote and /api/quote.
GOOGLE_MAPS_API_KEY=replace_with_google_maps_api_key

# Square payments — server only. Used by app/api/booking/route.js to create
# the Quick Pay checkout link a customer pays through after booking.
SQUARE_ACCESS_TOKEN=replace_with_square_access_token
SQUARE_LOCATION_ID=replace_with_square_location_id
SQUARE_ENVIRONMENT=production

# Public production URL used for Square checkout redirect and driver-confirm/booking-confirm links
NEXT_PUBLIC_SITE_URL=https://www.myblacklimoservice.com

# Optional Google Analytics 4
NEXT_PUBLIC_GA_MEASUREMENT_ID=replace_with_ga4_measurement_id

# Booking operations — currently unused by the codebase (no route reads this
# var); kept only as a note of the operational inbox. Safe to leave unset.
BOOKING_NOTIFICATION_EMAIL=info@myblacklimoservice.com

# --- Booking + dispatch backend ---------------------------------------

# Postgres — created automatically when you provision a database from the
# Vercel dashboard (Project > Storage > Create Database > Postgres). Vercel
# injects POSTGRES_URL itself; you do not set this by hand. Required by
# lib/db.js for everything account/booking-history related (users, bookings,
# otp_codes, drivers, ...).
# POSTGRES_URL=

# Signs/verifies every session, pending-signup, pending-login and OTP-proof
# cookie issued by lib/session.js (HMAC-SHA256). Required for auth to work
# at all — set this to a long random string once and never rotate it
# casually, or every signed-in customer is logged out.
AUTH_SECRET=replace_with_a_long_random_string

# Resend — server only. Sends the email OTP code (lib/otp.js / lib/email.js)
# for signup, login and guest booking email verification, AND (new) the
# management email alert when a booking needs manual dispatch — sent to
# every address in ADMIN_EMAILS below.
RESEND_API_KEY=replace_with_resend_api_key
RESEND_FROM=bookings@myblacklimoservice.com

# Twilio — Account SID + a Restricted API Key (SID + Secret), not the main
# Auth Token. From Twilio Console > Account > API keys & tokens. Used both
# for the raw SMS/WhatsApp/voice sending in lib/notify.js (driver dispatch,
# booking confirmations) AND for the self-rolled phone OTP in
# lib/phone-otp.js, which sends its 6-digit code via the same TWILIO_SMS_FROM
# sender rather than the separate Twilio Verify product (Twilio Verify
# cannot be provisioned with only a Restricted API Key — no Account Auth
# Token — so it is intentionally not used here; TWILIO_VERIFY_SERVICE_SID is
# not needed by this codebase).
TWILIO_ACCOUNT_SID=replace_with_twilio_account_sid
TWILIO_API_KEY_SID=replace_with_twilio_api_key_sid
TWILIO_API_KEY_SECRET=replace_with_twilio_api_key_secret

# Sending numbers/senders
TWILIO_SMS_FROM=replace_with_twilio_sms_number        # e.g. +61...
TWILIO_WHATSAPP_FROM=replace_with_twilio_whatsapp_sender # e.g. whatsapp:+61...
# Optional — falls back to TWILIO_SMS_FROM if not set
TWILIO_VOICE_FROM=

# Management's own mobile — gets an urgent SMS alert (in parallel with an
# email to everyone in ADMIN_EMAILS below) whenever a booking needs manual
# dispatch: no driver at all, no backup driver available to reassign to at
# T-50m, a reassigned driver still hasn't confirmed ~15 minutes later, or the
# customer still hasn't confirmed by 1 hour before pickup. Defaults to
# Tamer's own mobile (+61420770707) if left unset, so this alert always has
# somewhere to go even before this is configured in Vercel. Change it here
# any time without a code change.
ADMIN_ALERT_PHONE=+61420770707
# Older name for the same alert phone, still honoured as a fallback if
# ADMIN_ALERT_PHONE is unset (kept for backward compatibility).
DISPATCH_ALERT_PHONE=replace_with_dispatcher_mobile_number

# Protects /api/cron/dispatch. Set the SAME value in two places:
#  1. Here / Vercel > Project > Settings > Environment Variables
#  2. GitHub repo > Settings > Secrets and variables > Actions > New repository
#     secret, named CRON_SECRET
# The dispatch checkpoints (driver 24h/90m/75m/50m, customer 48h/24h/2h/1h)
# are driven by .github/workflows/dispatch-cron.yml (runs every 5 minutes)
# rather than Vercel Cron, because Vercel's Hobby plan only allows cron jobs
# to run once per day.
CRON_SECRET=replace_with_a_long_random_string

# Protects /api/admin/drivers (roster management) — send as header
# `x-admin-key: <value>`. Leave unset to keep that endpoint fully disabled.
ADMIN_API_KEY=replace_with_a_long_random_string

# Comma-separated list of email addresses treated as site admins (used by
# any admin-only page/route that checks the logged-in user's email against
# this list), AND as the recipient list for the manual-dispatch management
# email alert above. Leave unset to keep admin-gated features (and the email
# side of the alert) fully disabled — the SMS alert to ADMIN_ALERT_PHONE
# still goes out either way.
ADMIN_EMAILS=replace_with_comma_separated_admin_emails

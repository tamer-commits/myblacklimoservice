# Server-only Google Maps Platform credential
# Add the real value in Vercel Project Settings > Environment Variables.
# Never commit the real key.
GOOGLE_MAPS_API_KEY=replace_with_google_maps_api_key

# Google Analytics 4 measurement ID (example: G-XXXXXXXXXX)
NEXT_PUBLIC_GA_MEASUREMENT_ID=replace_with_ga4_measurement_id

# Booking delivery integration
BOOKING_NOTIFICATION_EMAIL=info@myblacklimoservice.com
